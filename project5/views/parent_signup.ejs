<html lang="en">
  <head>
    <title>Parental Signup</title>
    <link rel="stylesheet" href="../../stylesheets/parent_signup.css" />
  </head>
  <body>
    <div class="image-container">
      <img src="../assets/logo_column.svg" alt="" />
    </div>
    <div class="form-container">
      <form action="/parent/signup" method="POST">
        <input type="text" name="username" placeholder="Username" required />
        <input
          type="text"
          name="child_name"
          placeholder="Child's Name"
          required
        />
        <input
          type="password"
          name="password"
          placeholder="Password"
          required
        />
        <button type="submit">Sign Up</button>
      </form>
      <a href="/parent/login">Already Have An Account?</a>
    </div>
  </body>
</html>
